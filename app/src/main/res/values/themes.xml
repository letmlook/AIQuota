<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AIQuota" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/minimax_color</item>
        <item name="colorPrimaryVariant">@color/minimax_dark</item>
        <item name="colorOnPrimary">#000000</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/deepseek_color</item>
        <item name="colorSecondaryVariant">@color/deepseek_dark</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/card_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Text appearance -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Bottom Navigation -->
        <item name="bottomNavigationStyle">@style/Widget.AIQuota.BottomNavigation</item>
    </style>

    <style name="Widget.AIQuota.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="backgroundTint">@color/card_background</item>
        <item name="itemIconTint">@color/bottom_nav_color_new</item>
        <item name="itemTextColor">@color/bottom_nav_color_new</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.AIQuota.Button.Minimax" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/minimax_color</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="Widget.AIQuota.Button.DeepSeek" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/deepseek_color</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Widget.AIQuota.Card.Glass" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/glass_bg</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/glass_border</item>
    </style>
</resources>